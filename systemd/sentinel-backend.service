[Unit]
Description=Sentinel-X Autonomous Safety FastAPI Backend
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Sentinel-X-Complete
ExecStart=/home/pi/Sentinel-X-Complete/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --app-dir backend
Restart=always
RestartSec=3
Environment=PORT=8000
Environment=MQTT_HOST=127.0.0.1
Environment=MQTT_PORT=1883

[Install]
WantedBy=multi-user.target
